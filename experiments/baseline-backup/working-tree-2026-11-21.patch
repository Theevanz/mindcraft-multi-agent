+    const doorNote = skippedDoors ? ` (${skippedDoors} door halves deferred)` : '';
+    const occNote = occupied ? ` (${occupied} skipped: ${occupiedWho} in the way)` : '';
+    let out;
+    if (remaining === 0)
+        out = { message: `Level ${levelNum} complete. Move to level ${levelNum + 1} with !checkBlueprintLevel(${levelNum + 1}).${doorNote}`, placed, remaining, occupied };
+    else if (placed === 0)
